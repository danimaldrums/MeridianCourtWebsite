---
import SiteLayout from '../layouts/SiteLayout.astro';
import { arcs } from '../data/albums';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<SiteLayout title="Every ending begins" current="home">
  <section class="hero">
    <div class="hero-stars" aria-hidden="true"></div>
    <div class="hero-illustration" aria-hidden="true"><img src={base + 'images/meridian-court-profile-art.webp'} alt="" decoding="async" fetchpriority="high" onerror="this.hidden=true" /></div>
    <div class="hero-engine" aria-hidden="true"><div class="engine-ring outer"></div><div class="engine-ring inner"></div><div class="engine-ring heart"></div></div>
    <div class="hero-copy">
      <p class="overline">AN ARCHIVE OF POSSIBILITY</p>
      <h1>Every ending<br/><em>begins.</em></h1>
      <p class="hero-description">A cinematic metal saga of memory, consequence and the paths we choose to walk.</p>
      <div class="hero-actions">
        <a class="button button-gold" href={base + 'music/'}>Explore the music <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={base + 'archive/'}>Enter the Archive</a>
      </div>
    </div>
    <div class="hero-foot" aria-hidden="true"><span>THE MERIDIAN COURT SAGA</span><span>◇</span><span>THE STORY IS STILL UNFOLDING</span></div>
  </section>
  <section class="intro content-shell">
    <div>
      <p class="overline">01 / THE UNIVERSE</p>
      <h2>More than music.<br/><em>A world to discover.</em></h2>
    </div>
    <div class="intro-copy">
      <p>Across ancient civilisations, impossible futures and the spaces between them, Meridian Court follows the people who must choose what is worth preserving.</p>
      <p>Each album is a chapter. Each Archive offers a window into a larger story. No choice is without consequence.</p>
      <a class="text-link" href={base + 'chronology/'}>Discover the chronology <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="feature content-shell">
    <div class="section-ribbon"><span class="overline">02 / FEATURED RELEASE</span><span class="section-caption">ARC IV · CONTINUANCE</span></div>
    <div class="feature-layout">
      <div class="art-panel tone-dawn feature-art">
        <img class="approved-cover" src={base + 'images/arc-4-the-unwritten-dawn.webp'} alt="Official Meridian Court artwork for The Unwritten Dawn" loading="lazy" decoding="async" onerror="this.hidden=true" />
        <div class="art-circle"></div><div class="art-halo"></div><div class="art-horizon"></div>
        <div class="art-caption"><span>MERIDIAN COURT</span><strong>THE UNWRITTEN<br/>DAWN</strong><small>ARC IV · CONTINUANCE</small></div>
      </div>
      <div class="feature-copy">
        <p class="overline">THE LATEST RELEASED CHAPTER</p>
        <h2>The Unwritten<br/><em>Dawn</em></h2>
        <div class="small-rule"></div>
        <blockquote>“The future belongs to nobody yet.”</blockquote>
        <p>{arcs[4].summary}</p>
        <a class="button button-outline" href={base + 'music/#the-unwritten-dawn'}>Discover the album <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class="journey content-shell">
    <div class="section-ribbon"><span class="overline">03 / FOLLOW THE JOURNEY</span><a class="text-link" href={base + 'music/'}>All releases <span aria-hidden="true">→</span></a></div>
    <h2>Five arcs.<br/><em>One unfolding story.</em></h2>
    <div class="arc-list">
      {arcs.map((album) => (
        <a class="arc-item" href={base + 'music/#' + album.slug}>
          <span class="arc-number">{album.arc.replace('ARC ', '')}</span>
          <span class="arc-label"><span>{album.phase}</span><strong>{album.title}</strong></span>
          <span class="arc-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
  <section class="closing">
    <span class="closing-ornament" aria-hidden="true">✧</span>
    <p class="overline">THE ARCHIVE REMAINS OPEN</p>
    <h2>What will <em>you</em> discover?</h2>
    <p>Begin with the music. Follow the questions. Find the connections.</p>
    <a class="button button-gold" href={base + 'archive/'}>Open the Archive <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
