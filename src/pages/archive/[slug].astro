---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { codexRecords, codexBySlug, type CodexRecord } from '../../data/codex';
import { archiveDesignation } from '../../data/archive-identifiers';
import { peopleCompanion } from '../../data/codex-companion-people';
import { placesCompanion } from '../../data/codex-companion-places';
import { arcs, chronicles } from '../../data/albums';
export function getStaticPaths() {
  return codexRecords.map(record => ({ params: { slug: record.slug }, props: { record } }));
}
const { record } = Astro.props as { record: CodexRecord };
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const kindLabels = {character:'CHARACTER',location:'LOCATION',phenomenon:'PHENOMENON',narration:'ARCHIVE NARRATION'};
const album = [...arcs, ...chronicles].find(x => x.slug === record.albumSlug);
const designation = record.kind === 'narration' ? archiveDesignation(record.slug) : undefined;
const companion = record.kind === 'narration' ? undefined : (peopleCompanion[record.slug] ?? placesCompanion[record.slug]);
const related = record.kind === 'narration' ? [] : record.related.map(slug=>codexBySlug.get(slug)).filter((r):r is CodexRecord=>Boolean(r));
const hiddenMark = ({ 'the-seeker': { number:1, label:'I', fragment:'A PAGE' }, 'hall-of-architects': { number:2, label:'II', fragment:'WITHOUT A' }, 'the-path-within-archive-01': { number:3, label:'III', fragment:'NUMBER' } } as Record<string, {number:number;label:string;fragment:string}>)[record.slug];
---
<SiteLayout title={record.title} current="archive">
  <section class="content-shell codex-detail manuscript-detail">
    <nav class="codex-breadcrumb" aria-label="Breadcrumb"><a href={base + 'archive/'}>← Back to the Codex</a><span aria-hidden="true">/</span><span>{kindLabels[record.kind]}</span></nav>
    <div class="manuscript-book" role="group" aria-label={'Codex entry: '+record.title}>
      <article class="manuscript-page manuscript-left">
        <header class="manuscript-page-header"><span>THE MERIDIAN CODEX</span><span>{designation ? designation.label : 'FOLIO ✧'}</span></header>
        <div class="manuscript-decor" aria-hidden="true"><span>✧</span></div>
        <p class="folio-eyebrow">{kindLabels[record.kind]} · REGISTRY ACCESS I</p>
        <h1>{record.title}</h1>
        <div class="manuscript-art">
          {album && <img src={base + album.cover} alt={'Approved album artwork for '+album.title+'; thematic illustration, not a canonical portrait or depiction of this record'} width="360" height="360" loading="lazy"/>}
          <span class="manuscript-plate-caption">ILLUSTRATION: {album ? album.title : 'COURT ARCHIVE'}</span>
        </div>
        <p class="manuscript-opening">{record.kind === 'narration' ? ('Recovered testimony · '+(designation?.label || 'ARCHIVE')+' · '+record.albumTitle+'.') : record.summary}</p>
        <div class="manuscript-provenance"><span>RECORDED IN</span><a href={base + 'music/#' + record.albumSlug}>{record.albumTitle} ↗</a></div>
        {companion && <section class="manuscript-ledger" aria-label="Reference particulars">
          <h2>From the registry</h2>
          <dl>
            {companion.facts.map(([label, value])=><div class="manuscript-ledger-row"><dt>{label}</dt><dd>{value}</dd></div>)}
          </dl>
        </section>}
        {hiddenMark && <div class="manuscript-marginalia">
          <button type="button" class="folio-mark" data-folio-number={hiddenMark.number} data-folio-fragment={hiddenMark.fragment} aria-label={'Examine unusual marginal mark '+hiddenMark.label} aria-expanded="false">✧<span class="folio-mark-dot" aria-hidden="true">◈</span></button>
          <span class="folio-margin-caption">A mark in the margin. <em>It does not belong to this sequence.</em></span>
          <div class="folio-fragment" hidden aria-live="polite">
            <span>FRAGMENT {hiddenMark.label} / III</span>
            <strong>{hiddenMark.fragment}</strong>
            <small class="folio-progress"></small>
            <a class="folio-last-link" href={base+'archive/the-unindexed-record/'} hidden>Assemble the unindexed folio ↗</a>
          </div>
        </div>}
        <footer class="manuscript-page-footer"><span>THE RECORD ENDURES</span><span>Ⅰ</span></footer>
      </article>
      <article class="manuscript-page manuscript-right">
        <header class="manuscript-page-header"><span>{record.kind==='narration' ? (designation?.label || 'RECOVERED NARRATION') : 'HISTORICAL REFERENCE'}</span><span>CONTINUED</span></header>
        <div class="manuscript-decor manuscript-crest" aria-hidden="true"><span>◇</span></div>
        <h2>{record.kind === 'narration' ? 'The spoken record' : record.kind==='character' ? 'A life recorded' : record.kind==='location' ? 'A place remembered' : 'A history examined'}</h2>
        <p class="manuscript-lede">{record.kind==='narration' ? 'The words follow the sequence in which they were preserved in the Archive.' : 'Every account begins with what can be witnessed. Beyond that, the testimony must speak for itself.'}</p>
        {record.kind !== 'narration' && <div class="manuscript-overview">
          <span class="folio-eyebrow">THE ARCHIVIST'S INTRODUCTION</span>
          {record.body.map(paragraph=><p>{paragraph}</p>)}
        </div>}
        <details class="manuscript-disclosure">
          <summary>{record.kind==='narration' ? 'Unseal the original narration' : 'Continue reading the chapters'} <span aria-hidden="true">⌄</span></summary>
          <p class="manuscript-spoiler">READER'S CAUTION · The following account may reveal events beyond your current place in the chronology.</p>
          {record.kind==='narration'
            ? <pre class="manuscript-transcript">{record.body}</pre>
            : <div class="manuscript-prose manuscript-chapters">
                {companion?.chapters.map((chapter, index)=>
                  <section class="manuscript-chapter">
                    <p class="manuscript-chapter-number">CHAPTER {String(index+1).padStart(2,'0')}</p>
                    <h3>{chapter.heading}</h3>
                    {chapter.paragraphs.map(paragraph=><p>{paragraph}</p>)}
                  </section>
                )}
              </div>}
        </details>
        <div class="manuscript-aside">
          <span class="folio-eyebrow">A NOTE IN THE MARGIN</span>
          <p>{record.kind==='narration' ? 'Atmosphere and voice notation, where recorded, remain alongside the testimony.' : 'Where the records hold no answer, the margin remains unfilled.'}</p>
        </div>
        <footer class="manuscript-page-footer"><span>READ WHAT IS WRITTEN</span><span>Ⅱ</span></footer>
      </article>
    </div>
    <aside class="court-clearance-panel" aria-label="Restricted senior registry">
      <span class="court-clearance-glyph" aria-hidden="true">◇</span>
      <div>
        <p class="overline">SENIOR REGISTRY · RESTRICTED ANNEX</p>
        <h2>Further access requires higher clearance.</h2>
        <p>Your current designation allows consultation of this folio. Supplementary registers may only be examined under the authority of a senior archivist.</p>
      </div>
      <span class="court-clearance-stamp">CLEARANCE II REQUIRED</span>
    </aside>
    {related.length>0 && <section class="codex-connections" aria-label="Connected records">
      <div class="section-ribbon"><span class="overline">FOLLOW THE CONNECTIONS</span><span class="section-caption">OTHER PAGES IN THIS VOLUME</span></div>
      <div class="codex-related-grid">{related.map(item=><a href={base+'archive/'+item.slug+'/'} class="codex-related-item"><span class="overline">{kindLabels[item.kind]}</span><strong>{item.title}</strong><span aria-hidden="true">↗</span></a>)}</div>
    </section>}
    <p class="codex-footnote">MERIDIAN CODEX · GENERAL REGISTRY · END OF ACCESSIBLE ENTRY</p>
    <a class="button button-outline" href={base+'archive/'}>Return to the Codex ↗</a>
  </section>
  <script is:inline>
    (() => {
      const button = document.querySelector('[data-folio-number]');
      if (!button) return;
      const panel = document.querySelector('.folio-fragment');
      const lastLink = document.querySelector('.folio-last-link');
      const progress = document.querySelector('.folio-progress');
      const key = 'meridian-court-folios-v1';
      const read = () => {
        try { const saved = JSON.parse(localStorage.getItem(key) || '[]'); return Array.isArray(saved) ? saved.filter(x => [1,2,3].includes(x)) : []; }
        catch (_) { return []; }
      };
      const show = () => {
        const marks = read();
        panel.hidden = false;
        button.setAttribute('aria-expanded', 'true');
        progress.textContent = marks.length+' of 3 marginal marks observed.';
        if ([1,2,3].every(id => marks.includes(id))) lastLink.hidden = false;
      };
      if (read().includes(Number(button.dataset.folioNumber))) show();
      button.addEventListener('click', () => {
        const marks = read();
        const id = Number(button.dataset.folioNumber);
        if (!marks.includes(id)) marks.push(id);
        try { localStorage.setItem(key, JSON.stringify(marks)); } catch (_) {}
        show();
        if (lastLink.hidden === false) lastLink.focus();
      });
    })();
  </script>
</SiteLayout>
