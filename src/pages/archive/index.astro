---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { codexRecords } from '../../data/codex';
import { archiveDesignation } from '../../data/archive-identifiers';
import { arcs, chronicles } from '../../data/albums';
import '../../styles/codex-volume.css';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const albums = [...arcs, ...chronicles];
const chapters = [
 {key:'character',number:'I',name:'People of the Court',detail:'Lives & witnesses',count:codexRecords.filter(r=>r.kind==='character').length},
 {key:'location',number:'II',name:'Places & monuments',detail:'Worlds & thresholds',count:codexRecords.filter(r=>r.kind==='location').length},
 {key:'phenomenon',number:'III',name:'The unexplained',detail:'Events & anomalies',count:codexRecords.filter(r=>r.kind==='phenomenon').length},
 {key:'narration',number:'IV',name:'Spoken Archives',detail:'The recorded words',count:codexRecords.filter(r=>r.kind==='narration').length},
 {key:'all',number:'V',name:'The full register',detail:'Every accessible leaf',count:codexRecords.length}
];
const typeName: Record<string,string> = {character:'PERSON',location:'PLACE',phenomenon:'PHENOMENON',narration:'ARCHIVE'};
---
<SiteLayout title="The Meridian Codex" current="archive" description="Enter the general records of Meridian Court, an illustrated in-universe codex of people, places and archived testimony.">
 <section class="volume-entry content-shell" aria-label="The Meridian Codex">
  <p class="volume-entry-overline">THE MERIDIAN COURT · GENERAL REGISTRY</p>
  <div class="codex-volume" id="codex-volume">
   <div class="codex-opening-cover" id="codex-opening-cover" aria-hidden="true">
    <div class="codex-opening-cover-frame">
     <span class="cover-small">THE GENERAL RECORDS</span>
     <img src={base+'images/meridian-court-logo.webp'} alt="" width="170" height="170"/>
     <span class="cover-divider">✧ ◈ ✧</span>
     <span class="cover-main">The Meridian<br/><em>Codex</em></span>
     <span class="cover-small">VOLUME I · ACCESS BY DESIGNATION</span>
    </div>
   </div>
   <div class="codex-book-spine" aria-hidden="true"></div>
   <section class="codex-volume-leaf codex-volume-left" aria-labelledby="codex-contents-title">
    <div class="codex-volume-running"><span>MERIDIAN COURT</span><span>GENERAL REGISTER</span></div>
    <div class="codex-volume-flourish" aria-hidden="true">✣</div>
    <p class="volume-eyebrow">VOLUME I · CONTENTS</p>
    <h1 id="codex-contents-title">The <em>Meridian</em><br/>Codex</h1>
    <p class="codex-volume-intro">Here are held the lives, places and testimonies entrusted to the Court's memory. Your present designation admits you to the general register.</p>
    <div class="codex-volume-toc-heading"><span>TABLE OF CONTENTS</span><span>FOLIOS</span></div>
    <nav class="codex-volume-chapters" aria-label="Browse Codex chapters">
      {chapters.map((ch,index)=><button class="codex-chapter-tab" data-filter={ch.key} aria-pressed={index===0?'true':'false'} type="button">
       <span class="codex-chapter-numeral">{ch.number}</span>
       <span class="codex-chapter-name"><strong>{ch.name}</strong><small>{ch.detail}</small></span>
       <span class="codex-chapter-count">{String(ch.count).padStart(2,'0')} <span aria-hidden="true">→</span></span>
      </button>)}
    </nav>
    <aside class="codex-page-marginalia">A traveller without a name. A hall without a first stone. A first step spoken aloud. Three margins; one page.</aside>
    <footer class="codex-volume-leaf-bottom"><span>READER DESIGNATION: INITIATE</span><span>I</span></footer>
   </section>
   <section class="codex-volume-leaf codex-volume-right" aria-labelledby="codex-register-title" id="codex-index">
    <div class="codex-volume-running"><span>INDEX OF RECORDED MATTERS</span><span>CLEARANCE I</span></div>
    <p class="volume-eyebrow">ACCESS GRANTED · GENERAL REGISTER</p>
    <div class="codex-volume-heading">
     <h2 id="codex-register-title">The open <em>index</em></h2>
     <span class="codex-volume-signet" aria-hidden="true">✧</span>
    </div>
    <p class="codex-volume-blurb">Select a chapter from the facing page, or consult the register by name, subject or recorded designation.</p>
    <div class="codex-embedded-search">
      <label for="codex-search">CONSULT THE REGISTER</label>
      <div class="codex-embedded-search-field"><span aria-hidden="true">⌕</span><input id="codex-search" type="search" placeholder="Search names, places, Archive numbers…" autocomplete="off"/></div>
      <label for="codex-album">RELATED VOLUME</label>
      <select id="codex-album">
       <option value="all">All accessible volumes</option>
       {albums.map(album=><option value={album.slug}>{album.arc} · {album.title}</option>)}
      </select>
    </div>
    <div class="codex-page-index-heading"><span id="codex-selected-chapter">I · PEOPLE OF THE COURT</span><span id="codex-count" aria-live="polite">8 entries</span></div>
    <div class="codex-folio-list" id="codex-list" aria-label="Accessible folios">
     {codexRecords.map((entry,index)=>{
       const designation = entry.kind==='narration' ? archiveDesignation(entry.slug) : undefined;
       const idLabel = designation?.identifier ?? String(index+1).padStart(3,'0');
       return <a class="codex-folio-row" href={base+'archive/'+entry.slug+'/'} data-type={entry.kind} data-album={entry.albumSlug}
         data-search={(entry.title+' '+entry.albumTitle+' '+('albumArc' in entry ? entry.albumArc : '')+' '+('summary' in entry ? entry.summary : '')+' '+(designation?.identifier ?? '')).toLowerCase()}
         hidden={entry.kind!=='character'}>
         <span class="codex-folio-symbol" aria-hidden="true">{entry.kind==='character'?'♙':entry.kind==='location'?'⌂':entry.kind==='phenomenon'?'✧':'◈'}</span>
         <span class="codex-folio-name"><strong>{entry.title}</strong><small>{entry.kind==='narration' ? entry.albumTitle : typeName[entry.kind]+' · '+entry.albumTitle}</small></span>
         <span class="codex-folio-id">{idLabel}</span>
       </a>;
     })}
    </div>
    <p id="codex-empty" class="codex-no-entries" hidden>No folios meet the present enquiry. Try another term or volume.</p>
    <aside class="codex-index-sealed" aria-label="Restricted senior archives">
      <span aria-hidden="true">◇</span><p><strong>BEYOND THIS REGISTER</strong> Further records require the authority of a senior archivist.</p>
    </aside>
    <aside id="unindexed-discovery" class="codex-index-secret" hidden aria-live="polite">
      <span aria-hidden="true">✧</span><p>An unnumbered leaf has been found between these pages.</p>
      <a href={base+'archive/the-unindexed-record/'}>Consult the recovered folio →</a>
    </aside>
    <footer class="codex-volume-leaf-bottom"><span>THE RECORD ENDURES</span><span>II</span></footer>
   </section>
  </div>
  <p class="codex-afterword">THE COURT PRESERVES WHAT CAN BE RECORDED. NOT EVERY PAGE HAS BEEN NUMBERED.</p>
 </section>
 <script is:inline>
 (() => {
   const volume = document.getElementById('codex-volume');
   const cover = document.getElementById('codex-opening-cover');
   if (volume && cover && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
     volume.classList.add('is-opening');
     cover.addEventListener('animationend', () => {cover.hidden = true;volume.classList.remove('is-opening');}, {once:true});
   }
   const nav=[...document.querySelectorAll('.codex-chapter-tab')];
   const rows=[...document.querySelectorAll('.codex-folio-row')];
   const query=document.getElementById('codex-search');
   const album=document.getElementById('codex-album');
   const count=document.getElementById('codex-count');
   const title=document.getElementById('codex-selected-chapter');
   const empty=document.getElementById('codex-empty');
   let active='character';
   const filter=()=>{
     const q=(query.value||'').toLocaleLowerCase().trim();
     let found=0;
     for(const row of rows){
       const show=(active==='all'||row.dataset.type===active)
         &&(album.value==='all'||row.dataset.album===album.value)
         &&(!q||row.dataset.search.includes(q));
       row.hidden=!show;
       if(show)found++;
     }
     count.textContent=found+(found===1?' entry':' entries');
     const selected=nav.find(x=>x.dataset.filter===active);
     title.textContent=selected ? selected.querySelector('.codex-chapter-numeral').textContent+' · '+selected.querySelector('strong').textContent.toUpperCase() : 'GENERAL REGISTER';
     empty.hidden=found!==0;
   };
   for(const button of nav)button.addEventListener('click',()=>{
     active=button.dataset.filter;
     for(const tab of nav)tab.setAttribute('aria-pressed', String(tab===button));
     filter();
     if(window.matchMedia('(max-width: 800px)').matches)document.getElementById('codex-index').scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});
   });
   query.addEventListener('input',()=>{
     if(query.value.trim() && active!=='all'){
       active='all';
       for(const tab of nav)tab.setAttribute('aria-pressed', String(tab.dataset.filter===active));
     }
     filter();
   });
   album.addEventListener('change',filter);
   const discovery=document.getElementById('unindexed-discovery');
   try {
     const marks=JSON.parse(localStorage.getItem('meridian-court-folios-v1')||'[]');
     if(Array.isArray(marks)&&[1,2,3].every(id=>marks.includes(id)))discovery.hidden=false;
   }catch(_){}
   filter();
 })();
 </script>
</SiteLayout>