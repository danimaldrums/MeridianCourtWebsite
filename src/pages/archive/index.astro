---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { codexRecords } from '../../data/codex';
import { arcs, chronicles } from '../../data/albums';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const albums = [ ...arcs, ...chronicles ];
const types = [
  { kind:'all', label:'All records' },
  { kind:'character', label:'Characters' },
  { kind:'location', label:'Locations' },
  { kind:'narration', label:'Album Archives' },
  { kind:'phenomenon', label:'Phenomena' }
];
const counts = {
  character: codexRecords.filter(e=>e.kind==='character').length,
  location: codexRecords.filter(e=>e.kind==='location').length,
  narration: codexRecords.filter(e=>e.kind==='narration').length,
  phenomenon: codexRecords.filter(e=>e.kind==='phenomenon').length
};
const typeName = {character:'CHARACTER',location:'LOCATION',narration:'ARCHIVE NARRATION',phenomenon:'PHENOMENON'};
---
<SiteLayout title="The Archive" current="archive">
  <section class="codex-cover-intro content-shell" aria-labelledby="codex-title">
    <div class="codex-cover" aria-label="The Meridian Codex">
      <div class="codex-cover-frame">
        <p class="codex-cover-kicker">A COMPANION TO THE MERIDIAN COURT SAGA</p>
        <img class="codex-cover-logo" src={base + 'images/meridian-court-logo.webp'} alt="Meridian Court official logo" width="240" height="240"/>
        <span class="codex-cover-rule" aria-hidden="true">✧ ───── ◈ ───── ✧</span>
        <h1 id="codex-title">The <em>Meridian</em> Codex</h1>
        <p class="codex-cover-caption">PEOPLE · PLACES · RECOVERED WORDS</p>
        <p class="codex-cover-epigraph">Every page is a doorway. Not every doorway appears in the index.</p>
        <span class="codex-cover-clock" aria-hidden="true">Ⅰ &nbsp; · &nbsp; Ⅻ &nbsp; · &nbsp; Ⅰ</span>
      </div>
    </div>
    <div class="codex-intro-page">
      <p class="folio-eyebrow">VOLUME I &nbsp; / &nbsp; PUBLIC RECORDS</p>
      <span class="codex-intro-emblem" aria-hidden="true">✧</span>
      <h2>Open the <em>Archive</em></h2>
      <p>Walk the corridors of the Meridian Court. Follow a life across the centuries, revisit a forgotten place, or open the words preserved between the songs.</p>
      <div class="codex-tallies" aria-label="Archive index totals">
        <span><strong>{counts.character}</strong> characters</span>
        <span><strong>{counts.location}</strong> locations</span>
        <span><strong>{counts.narration}</strong> narrations</span>
        <span><strong>{counts.phenomenon}</strong> phenomena</span>
      </div>
      <div class="codex-intro-bottom"><span>CURATED FROM RELEASED CANON</span><span>EST. ✧</span></div>
    </div>
  </section>
  <section class="content-shell codex-content">
    <div class="codex-index-head">
      <p class="overline">THE OPEN INDEX</p>
      <h2>Find a record</h2>
      <p>Search the publicly released story. The Archive preserves what has been established, while leaving its unanswered questions intact.</p>
    </div>
    <aside id="unindexed-discovery" class="codex-unindexed-discovery" hidden aria-live="polite">
      <span aria-hidden="true">✧</span>
      <p>A loose folio has been recovered.</p>
      <a href={base + 'archive/the-unindexed-record/'}>Open the unindexed page ↗</a>
    </aside>
    <div class="codex-toolbar">
      <label class="codex-field">
        <span class="overline">SEARCH THE CODEX</span>
        <input id="codex-search" type="search" placeholder="A person, place, title or idea…" autocomplete="off" aria-label="Search archive records"/>
      </label>
      <label class="codex-field codex-album-filter">
        <span class="overline">ALBUM / CHRONICLE</span>
        <select id="codex-album" aria-label="Filter Archive by album">
          <option value="all">All released chapters</option>
          {albums.map(album => <option value={album.slug}>{album.arc} · {album.title}</option>)}
        </select>
      </label>
    </div>
    <nav class="codex-filters" aria-label="Filter record type">
      {types.map((type,index) => <button type="button" class="codex-filter" data-filter={type.kind} aria-pressed={index===0 ? 'true' : 'false'}>{type.label}</button>)}
    </nav>
    <div class="codex-result-line" aria-live="polite"><span id="codex-count">{codexRecords.length} records found</span><span class="section-caption">EXPLORE / READ / CONNECT</span></div>
    <div id="codex-grid" class="codex-grid">
      {codexRecords.map((entry,index) => (
        <a class="codex-record" href={base + 'archive/' + entry.slug + '/'}
          data-type={entry.kind}
          data-album={entry.albumSlug}
          data-search={(entry.title+' '+(entry.kind==='narration' ? entry.albumTitle+' '+entry.albumArc : entry.summary+' '+entry.albumTitle)).toLowerCase()}>
          <div class="codex-record-top"><span class="overline">{typeName[entry.kind]}</span><span class="codex-record-number">{String(index+1).padStart(3,'0')}</span></div>
          <h2>{entry.title}</h2>
          <p>{entry.kind==='narration' ? ('Read the original spoken Archive '+String(entry.archiveNumber).padStart(2,'0')+' from '+entry.albumTitle+'.') : entry.summary}</p>
          <div class="codex-record-bottom"><span>{entry.albumTitle}</span><span aria-hidden="true">↗</span></div>
        </a>
      ))}
    </div>
    <p id="codex-empty" class="codex-empty" hidden>No matching public records. Try another search or chapter.</p>
    <p class="codex-boundary">Archive narrations contain story revelations. Individual records open with a spoiler-aware reading view. This public Codex does not include unreleased albums, production prompts or undecided history.</p>
  </section>
  <script is:inline>
    (() => {
      const discoveries = document.getElementById('unindexed-discovery');
      try {
        const marks = JSON.parse(localStorage.getItem('meridian-court-folios-v1') || '[]');
        if (Array.isArray(marks) && [1,2,3].every(id => marks.includes(id))) discoveries.hidden = false;
      } catch (_) { /* Browsers with blocked storage can still use the page links. */ }
      const search = document.getElementById('codex-search');
      const album = document.getElementById('codex-album');
      const filters = [...document.querySelectorAll('.codex-filter')];
      const cards = [...document.querySelectorAll('.codex-record')];
      const count = document.getElementById('codex-count');
      const empty = document.getElementById('codex-empty');
      let kind = 'all';
      const refresh = () => {
        const q = (search.value || '').toLowerCase().trim();
        let visible = 0;
        for (const card of cards) {
          const show = (kind === 'all' || card.dataset.type === kind)
            && (album.value === 'all' || card.dataset.album === album.value)
            && (!q || card.dataset.search.includes(q));
          card.hidden = !show;
          if(show) visible++;
        }
        count.textContent = visible + (visible === 1 ? ' record found' : ' records found');
        empty.hidden = visible !== 0;
      };
      search.addEventListener('input', refresh);
      album.addEventListener('change', refresh);
      for (const button of filters) {
        button.addEventListener('click', () => {
          kind = button.dataset.filter;
          for (const other of filters) other.setAttribute('aria-pressed', String(other === button));
          refresh();
        });
      }
    })();
  </script>
</SiteLayout>
