---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { referenceRecords, codexBySlug } from '../../data/codex';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const threads = referenceRecords.map(record => ({
  record,
  connections: record.related.map(slug => codexBySlug.get(slug)).filter((entry): entry is NonNullable<typeof entry> => Boolean(entry)),
}));
const people = threads.filter(item => item.record.kind === 'character');
const places = threads.filter(item => item.record.kind === 'location');
const phenomena = threads.filter(item => item.record.kind === 'phenomenon');
---
<SiteLayout title="Threads of History" current="archive" description="Follow documented connections across the released Meridian Court Codex.">
  <main class="content-shell history-shell">
    <nav aria-label="Breadcrumb"><a href={base+'archive/'}>← The Meridian Codex</a></nav>
    <header class="history-intro">
      <p class="overline">THE MERIDIAN COURT · CROSS-REFERENCE REGISTER</p>
      <h1>Threads of <em>History</em></h1>
      <p>Every connection below comes from the published Codex register. Follow a thread through people, places and testimony. Where the records are silent, the silence remains.</p>
    </header>
    <nav class="history-jumps" aria-label="Explore threads">
      <a href="#people">People</a><a href="#places">Places & structures</a><a href="#phenomena">The unexplained</a><a href="#reading-ledger">Reading ledger</a>
    </nav>
    {[
      {id:'people',title:'Lives & witnesses',items:people},
      {id:'places',title:'Places & structures',items:places},
      {id:'phenomena',title:'Events & anomalies',items:phenomena}
    ].map(section => <section id={section.id} class="history-section">
      <h2>{section.title}</h2>
      <div class="history-grid">
        {section.items.map(({record,connections}) => <article class="history-card">
          <p class="overline">{record.kind.toUpperCase()} · {record.albumTitle}</p>
          <h3><a href={base+'archive/'+record.slug+'/'}>{record.title}</a></h3>
          <p>{record.summary}</p>
          {connections.length>0 && <div class="history-connections">
            <span>DOCUMENTED CONNECTIONS</span>
            <ul>{connections.map(item => <li><a href={base+'archive/'+item.slug+'/'}>{item.title}</a></li>)}</ul>
          </div>}
        </article>)}
      </div>
    </section>)}
    <section id="reading-ledger" class="history-ledger">
      <p class="overline">PERSONAL FIELD NOTES</p>
      <h2>Your reading ledger</h2>
      <p>Save this page for later. Your saved record stays on this device and is not sent to the Court.</p>
      <button id="history-save" type="button">Save Threads of History</button>
      <p id="history-saved-status" role="status" aria-live="polite"></p>
      <p><a href={base+'archive/'}>Return to the general register →</a></p>
    </section>
  </main>
  <script>
    const key = 'meridian-court-reading-ledger-v1';
    const button = document.getElementById('history-save') as HTMLButtonElement | null;
    const status = document.getElementById('history-saved-status');
    if (button && status) {
      const read = (): string[] => {
        try { const value = JSON.parse(localStorage.getItem(key) || '[]'); return Array.isArray(value) ? value.filter((v):v is string => typeof v === 'string') : []; }
        catch { return []; }
      };
      const refresh = () => {
        const saved = read().includes('threads-of-history');
        button.textContent = saved ? 'Remove from reading ledger' : 'Save Threads of History';
        status.textContent = saved ? 'Saved on this device.' : 'Not yet saved.';
      };
      button.addEventListener('click', () => {
        const saved = read();
        const updated = saved.includes('threads-of-history') ? saved.filter(x => x !== 'threads-of-history') : [...saved,'threads-of-history'];
        try { localStorage.setItem(key,JSON.stringify(updated)); refresh(); }
        catch { status.textContent = 'Your browser did not allow local saving.'; }
      });
      refresh();
    }
  </script>
  <style>
    .history-shell{padding-top:2rem;padding-bottom:5rem}
    .history-shell a{color:inherit}
    .history-intro{max-width:780px;margin:3rem 0}
    .history-intro h1{font:500 clamp(3rem,7vw,5rem)/1.05 'Cormorant Garamond',Georgia,serif}
    .history-intro>p:last-child{font-size:1.12rem;line-height:1.7}
    .history-jumps{display:flex;flex-wrap:wrap;gap:.75rem;margin-bottom:3rem}
    .history-jumps a,.history-ledger button{padding:.7rem 1rem;border:1px solid #ad8b52;background:transparent;color:inherit;text-decoration:none;cursor:pointer}
    .history-section{scroll-margin-top:3rem;margin:3rem 0}
    .history-section h2,.history-ledger h2{font:500 2.5rem 'Cormorant Garamond',Georgia,serif}
    .history-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:1.2rem}
    .history-card{padding:1.5rem;border:1px solid rgba(173,139,82,.48);background:rgba(173,139,82,.07)}
    .history-card h3{font:500 1.8rem 'Cormorant Garamond',Georgia,serif;margin:.7rem 0}
    .history-card>p{line-height:1.6}
    .history-connections{margin-top:1.3rem;border-top:1px solid rgba(173,139,82,.35);padding-top:1rem}
    .history-connections span{font-size:.7rem;letter-spacing:.12em}
    .history-connections ul{padding-left:1.2rem;line-height:1.9}
    .history-ledger{margin-top:4rem;padding:1.5rem;border:1px solid rgba(173,139,82,.48)}
    @media(max-width:600px){.history-intro{margin:2rem 0}.history-card{padding:1.1rem}}
  </style>
</SiteLayout>